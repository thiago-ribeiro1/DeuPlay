# Copie para .env e ajuste conforme necessario. Todos os valores abaixo sao
# os defaults aplicados quando a variavel nao esta definida (ver server/config.js).

PORT=3000
HOST=127.0.0.1

MEDIA_ROOT=media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

MAX_PLAYLIST_SIZE_BYTES=26214400
MAX_PLAYLIST_CHANNELS=20000

MAX_ACTIVE_STREAMS=4
MAX_ACTIVE_TRANSCODES=2
MAX_VIEWERS_PER_STREAM=50

PROBE_TIMEOUT_MS=10000
STREAM_START_TIMEOUT_MS=20000
STREAM_IDLE_TIMEOUT_MS=60000
VIEWER_HEARTBEAT_INTERVAL_MS=10000
VIEWER_SESSION_TIMEOUT_MS=30000

STREAM_RESTART_LIMIT=4
STREAM_RESTART_WINDOW_MS=300000

HLS_SEGMENT_DURATION=4
HLS_PLAYLIST_SIZE=8

FFMPEG_LOG_LEVEL=warning
LOG_LEVEL=info

ALLOWED_STREAM_PROTOCOLS=http,https,rtsp,rtmp

# backend_only (default em desenvolvimento): nunca tenta URL direta no navegador
#   e nunca cai de volta pra ela silenciosamente; toda reproducao passa por
#   sessao no backend (probe + proxy/remux/transcode), mesmo canais ja
#   compativeis com o navegador.
# backend_preferred: sempre pergunta ao backend primeiro, mas o motor de
#   estrategia pode escolher "direct" (URL original) quando for a melhor opcao.
# direct_preferred: comportamento antigo - tenta a URL direta no navegador
#   primeiro, so cai pro backend se todas as tentativas diretas falharem.
PLAYBACK_MODE=backend_only

# auto | on | off — em "auto" o backend detecta e testa NVENC/QuickSync/VAAPI/
# VideoToolbox/AMF e usa o primeiro que funcionar nesta maquina, caindo para
# libx264 (software) se nenhum funcionar.
HARDWARE_ACCELERATION=auto

# Defina como true apenas em ambiente de teste controlado: permite URLs
# apontando para localhost/rede privada (por padrao, bloqueadas por seguranca).
ALLOW_PRIVATE_HOSTS=false
